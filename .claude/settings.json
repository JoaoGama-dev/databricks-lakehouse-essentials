{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(ruff check *)",
      "Bash(.venv/Scripts/ruff.exe check *)",
      "Bash(.venv/bin/ruff check *)",
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(.venv/Scripts/pytest.exe *)",
      "Bash(.venv/bin/pytest *)",
      "Bash(databricks bundle validate *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(python data/gerar_dados_exemplo.py *)",
      "Bash(python scripts/perfilar_dados.py *)",
      "Bash(.venv/Scripts/python.exe scripts/perfilar_dados.py *)",
      "PowerShell(ruff check *)",
      "PowerShell(.venv\\Scripts\\ruff.exe check *)",
      "PowerShell(pytest *)",
      "PowerShell(python -m pytest *)",
      "PowerShell(.venv\\Scripts\\pytest.exe *)",
      "PowerShell(databricks bundle validate *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(python data/gerar_dados_exemplo.py *)",
      "PowerShell(python scripts/perfilar_dados.py *)",
      "PowerShell(.venv\\Scripts\\python.exe scripts/perfilar_dados.py *)",
      "PowerShell(.venv\\Scripts\\python.exe scripts\\perfilar_dados.py *)"
    ],
    "ask": [
      "Bash(databricks bundle deploy *)",
      "Bash(databricks bundle run *)",
      "Bash(databricks fs cp *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "PowerShell(databricks bundle deploy *)",
      "PowerShell(databricks bundle run *)",
      "PowerShell(databricks fs cp *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "Edit(./.github/workflows/deploy.yml)"
    ],
    "deny": [
      "Bash(databricks bundle deploy -t prod*)",
      "Bash(databricks bundle deploy --target prod*)",
      "Bash(databricks bundle deploy --target=prod*)",
      "Bash(databricks bundle destroy *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "PowerShell(databricks bundle deploy -t prod*)",
      "PowerShell(databricks bundle deploy --target prod*)",
      "PowerShell(databricks bundle deploy --target=prod*)",
      "PowerShell(databricks bundle destroy *)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./data/privado/**)",
      "Read(./data/tabela_*)",
      "Read(./.databricks/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/proteger_comandos.py"],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/proteger_arquivos.py"],
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/lint_apos_edicao.py"],
            "timeout": 90
          }
        ]
      }
    ]
  }
}
