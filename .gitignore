# Databricks: estado local da CLI e do bundle
.databricks/

# Python
__pycache__/
.venv/
.pytest_cache/
.ruff_cache/
.coverage

# Segredos locais (tokens, credenciais): nunca no repositório
.env
.env.*

# Configurações pessoais de ferramentas e do sistema operacional
.claude/settings.local.json
.vscode/
.idea/
.DS_Store
Thumbs.db

# Dados de clientes têm informação pessoal (LGPD): nunca vão para o repositório
# nem para o workspace (o bundle não sincroniza o que está aqui).
data/*.csv
data/*.json
data/*.parquet
data/privado/
# Exceção: agendas 100% fictícias do gerador (data/gerar_dados_exemplo.py).
!data/agenda_exemplo_v*.csv
