{
  "datasets": [
    {
      "name": "ds_indicadores",
      "displayName": "Indicadores mensais",
      "queryLines": [
        "SELECT dt_mes_entrevista, nm_area, st_situacao, st_entrevista, qt_entrevistas,\n",
        "  qt_compareceram, qt_aprovados, qt_sem_retorno\n",
        "FROM gold_agg_entrevista_mensal"
      ]
    },
    {
      "name": "ds_entrevistas",
      "displayName": "Entrevistas (detalhe)",
      "queryLines": [
        "SELECT\n",
        "  f.dt_entrevista,\n",
        "  f.dt_mes_entrevista,\n",
        "  f.hr_entrevista,\n",
        "  f.nm_candidato,\n",
        "  f.nm_vaga,\n",
        "  d.nm_area,\n",
        "  f.st_entrevista,\n",
        "  f.st_situacao,\n",
        "  f.nr_telefone,\n",
        "  f.id_cargo,\n",
        "  f.fl_sem_retorno\n",
        "FROM gold_fato_entrevista AS f\n",
        "JOIN gold_dim_cargo AS d\n",
        "  ON f.id_cargo = d.id_cargo"
      ]
    },
    {
      "name": "ds_pendencias",
      "displayName": "Pendências",
      "queryLines": [
        "WITH entrevistas AS (\n",
        "SELECT\n",
        "  f.dt_entrevista,\n",
        "  f.dt_mes_entrevista,\n",
        "  f.hr_entrevista,\n",
        "  f.nm_candidato,\n",
        "  f.nm_vaga,\n",
        "  d.nm_area,\n",
        "  f.st_entrevista,\n",
        "  f.st_situacao,\n",
        "  f.nr_telefone,\n",
        "  f.id_cargo,\n",
        "  f.fl_sem_retorno\n",
        "FROM gold_fato_entrevista AS f\n",
        "JOIN gold_dim_cargo AS d\n",
        "  ON f.id_cargo = d.id_cargo\n",
        ")\n",
        "SELECT 'Sem retorno' AS ds_motivo, dt_entrevista, hr_entrevista, nm_candidato, nm_vaga,\n",
        "  nm_area, st_entrevista, nr_telefone\n",
        "FROM entrevistas WHERE fl_sem_retorno\n",
        "UNION ALL\n",
        "SELECT 'Status não identificado', dt_entrevista, hr_entrevista, nm_candidato, nm_vaga,\n",
        "  nm_area, st_entrevista, nr_telefone\n",
        "FROM entrevistas WHERE st_situacao = 'Não identificado'\n",
        "UNION ALL\n",
        "SELECT 'Vaga sem área cadastrada', dt_entrevista, hr_entrevista, nm_candidato, nm_vaga,\n",
        "  nm_area, st_entrevista, nr_telefone\n",
        "FROM entrevistas WHERE id_cargo = -1"
      ]
    }
  ],
