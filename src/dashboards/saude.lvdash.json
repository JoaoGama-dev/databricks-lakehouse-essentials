{
  "datasets": [
    {
      "name": "ds_atualizacao",
      "displayName": "Atualização da carga",
      "queryLines": [
        "SELECT nm_tabela, dh_ultima_ingestao, dh_ultima_atualizacao, qt_horas_sem_atualizacao,\n",
        "  fl_atrasada, CAST(fl_atrasada AS INT) AS qt_atrasada\n",
        "FROM mon_atualizacao"
      ]
    },
    {
      "name": "ds_qualidade",
      "displayName": "Qualidade diária",
      "queryLines": [
        "SELECT dt_execucao, nm_tabela, nm_regra, ds_acao, qt_aprovadas, qt_descartadas, qt_alertas\n",
        "FROM mon_qualidade_diaria"
      ]
    },
    {
      "name": "ds_custo",
      "displayName": "Custo diário",
      "queryLines": [
        "SELECT dt_uso, nm_recurso, ds_produto, qt_dbus, vl_custo_lista, sg_moeda\n",
        "FROM mon_custo_diario\n",
        "WHERE dt_uso >= current_date() - INTERVAL 90 DAYS"
      ]
    }
  ],
